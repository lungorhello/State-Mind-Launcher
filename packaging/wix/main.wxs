<?xml version="1.0" ?><ns0:Wix xmlns:ns0="http://wixtoolset.org/schemas/v4/wxs">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else ?>
    <?define JpInstallScope="perUser"?>
  <?endif ?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif ?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif ?>

  <ns0:Package Name="$(var.JpAppName)" Language="$(var.JpProductLanguage)" Version="$(var.JpAppVersion)" Manufacturer="$(var.JpAppVendor)" UpgradeCode="$(var.JpProductUpgradeCode)" InstallerVersion="$(var.JpInstallerVersion)" Compressed="$(var.JpCompressedMsi)" ProductCode="$(var.JpProductCode)" Scope="$(var.JpInstallScope)"><ns0:SummaryInformation Manufacturer="$(var.JpAppVendor)" Description="$(var.JpAppDescription)"></ns0:SummaryInformation>

    

    <ns0:Media Id="1" Cabinet="Data.cab" EmbedCab="yes"></ns0:Media>

    <ns0:Upgrade Id="$(var.JpProductUpgradeCode)">
      <ns0:UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)" Property="JP_UPGRADABLE_FOUND" Maximum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)"></ns0:UpgradeVersion>
      <ns0:UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)" Property="JP_DOWNGRADABLE_FOUND" Minimum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)"></ns0:UpgradeVersion>
    </ns0:Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <ns0:CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)"></ns0:CustomAction>
    <?endif ?>
    <?ifndef JpAllowDowngrades ?>
    <ns0:CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)"></ns0:CustomAction>
    <?endif ?>

    <ns0:Binary Id="JpCaDll" SourceFile="wixhelper.dll"></ns0:Binary>

    <ns0:CustomAction Id="JpFindRelatedProducts" BinaryRef="JpCaDll" DllEntry="FindRelatedProductsEx"></ns0:CustomAction>

    <!-- Standard required root -->
    

    <ns0:Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ns0:ComponentGroupRef Id="Shortcuts"></ns0:ComponentGroupRef>
      <ns0:ComponentGroupRef Id="Files"></ns0:ComponentGroupRef>
      <ns0:ComponentGroupRef Id="FileAssociations"></ns0:ComponentGroupRef>
      <ns0:ComponentGroupRef Id="FragmentOsCondition"></ns0:ComponentGroupRef>
    </ns0:Feature>

    <ns0:CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]"></ns0:CustomAction>
    <ns0:CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)"></ns0:CustomAction>
    <ns0:CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)"></ns0:CustomAction>
    <ns0:CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)"></ns0:CustomAction>

    <?ifdef JpHelpURL ?>
      <ns0:CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)"></ns0:CustomAction>
    <?endif ?>

    <?ifdef JpAboutURL ?>
      <ns0:CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)"></ns0:CustomAction>
    <?endif ?>

    <?ifdef JpUpdateURL ?>
      <ns0:CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)"></ns0:CustomAction>
    <?endif ?>

    <?ifdef JpIcon ?>
    <ns0:Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"></ns0:Property>
    <ns0:Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"></ns0:Icon>
    <?endif ?>

    <ns0:UIRef Id="JpUI"></ns0:UIRef>

    <!--
      ════════════════════════════════════════════════════════════════════════
       StateMind 定制：卸载时可以顺带删掉游戏数据
      ════════════════════════════════════════════════════════════════════════

      REMOVE_MINECRAFT 由自定义卸载对话框里的勾选框写入（0 = 保留，1 = 删除）。
      Secure="yes" 让它能穿过 UI → Execute 序列，被下面的延迟自定义动作读到。

      删除本身走 WiX 官方 util 扩展的 WixQuietExec：它执行一条命令行、
      并且**不弹黑框**。用 rmdir 而不是自写脚本，失败也不影响卸载完成
      （Return="ignore"），最坏情况只是没删干净。
    -->
    <ns0:Property Id="REMOVE_MINECRAFT" Value="0" Secure="yes"></ns0:Property>

    <ns0:CustomAction Id="JpSetRemoveMinecraftCmd" Property="JpRemoveMinecraftCmd" Execute="immediate"
                      Value="&quot;[SystemFolder]cmd.exe&quot; /c rmdir /s /q &quot;[AppDataFolder]StateMind\.minecraft&quot;"></ns0:CustomAction>
    <ns0:CustomAction Id="JpRemoveMinecraftCmd" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                      Execute="deferred" Impersonate="yes" Return="ignore"></ns0:CustomAction>

    <ns0:UIRef Id="JpRemoveDataUI"></ns0:UIRef>

    <ns0:InstallExecuteSequence>
      <ns0:Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <ns0:Custom Action="JpSetARPCOMMENTS" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <ns0:Custom Action="JpSetARPCONTACT" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <ns0:Custom Action="JpSetARPSIZE" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <?ifdef JpHelpURL ?>
        <ns0:Custom Action="JpSetARPHELPLINK" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <?endif ?>
      <?ifdef JpAboutURL ?>
        <ns0:Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <?endif ?>
      <?ifdef JpUpdateURL ?>
        <ns0:Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize" Condition="Not Installed"></ns0:Custom>
      <?endif ?>

      <?ifndef JpAllowUpgrades ?>
      <ns0:Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts" Condition="JP_UPGRADABLE_FOUND"></ns0:Custom>
      <?endif ?>
      <?ifndef JpAllowDowngrades ?>
      <ns0:Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts" Condition="JP_DOWNGRADABLE_FOUND"></ns0:Custom>
      <?endif ?>
      <ns0:LaunchConditions Before="AppSearch"></ns0:LaunchConditions>
      <ns0:RemoveExistingProducts Before="CostInitialize"></ns0:RemoveExistingProducts>
      <ns0:Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"></ns0:Custom>

      <!-- 只有「真卸载」且用户勾了勾选框才删数据；修安装(REPAIR)、改安装、以及
           升级时静默移除旧版都不会触发（那时对话框根本没出现，属性还是 0）。 -->
      <ns0:Custom Action="JpSetRemoveMinecraftCmd" Before="JpRemoveMinecraftCmd"
                  Condition="REMOVE_MINECRAFT=&quot;1&quot; AND REMOVE~=&quot;ALL&quot;"></ns0:Custom>
      <ns0:Custom Action="JpRemoveMinecraftCmd" After="RemoveFiles"
                  Condition="REMOVE_MINECRAFT=&quot;1&quot; AND REMOVE~=&quot;ALL&quot;"></ns0:Custom>
    </ns0:InstallExecuteSequence>

    <ns0:InstallUISequence>
      <ns0:Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"></ns0:Custom>
    </ns0:InstallUISequence>

  </ns0:Package>

  <!--
    ══════════════════════════════════════════════════════════════════════════
     自定义卸载对话框
    ══════════════════════════════════════════════════════════════════════════

     WixUI 的「更改、修复或删除安装」页上，删除按钮原本直接跳 VerifyReadyDlg。
     这里把它的 NewDialog 目标改成本项目自己的对话框。

     为什么 Order 要写 10：MSI 规定同一个控件上多个 NewDialog 事件同时成立时，
     **Ordering 最大的那个生效**（见 ControlEvent 表文档）。内置那条 Order 很小，
     所以 10 一定压得住它。这个数字不能省，省了就完全不生效。

     注意本文件放在 resource-dir 里覆盖 jpackage 生成的默认 main.wxs，
     而 UI 元素必须被 UIRef 引用才会被链接进去（否则会被静默丢弃）。
  -->
  <ns0:Fragment>
    <ns0:UI Id="JpRemoveDataUI">
      <ns0:DialogRef Id="JpRemoveDataDlg"></ns0:DialogRef>

      <ns0:Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog"
                   Value="JpRemoveDataDlg" Order="10" Condition="1"></ns0:Publish>

      <ns0:Publish Dialog="JpRemoveDataDlg" Control="Back" Event="NewDialog"
                   Value="MaintenanceTypeDlg" Order="2" Condition="1"></ns0:Publish>
      <ns0:Publish Dialog="JpRemoveDataDlg" Control="Next" Event="NewDialog"
                   Value="MaintenanceWelcomeDlg" Order="2" Condition="1"></ns0:Publish>
    </ns0:UI>
  </ns0:Fragment>

  <ns0:Fragment>
    <ns0:UI Id="JpRemoveDataDlgUI">
      <ns0:Dialog Id="JpRemoveDataDlg" Width="370" Height="270" Title="卸载 [ProductName]">
        <ns0:Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="no"></ns0:Control>
        <ns0:Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"></ns0:Control>
        <ns0:Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"></ns0:Control>

        <ns0:Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15"
                     Text="{\WixUI_Font_Title}卸载 [ProductName]" Transparent="yes" NoPrefix="yes" TabSkip="yes"></ns0:Control>
        <ns0:Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="20"
                     Text="是否同时删除游戏数据。" Transparent="yes" NoPrefix="yes" TabSkip="yes"></ns0:Control>

        <ns0:Control Id="QuestionText" Type="Text" X="25" Y="62" Width="320" Height="16"
                     Text="卸载后，游戏版本、模组、存档、" NoPrefix="yes" TabSkip="yes"></ns0:Control>
        <ns0:Control Id="NoteText1" Type="Text" X="25" Y="82" Width="320" Height="16"
                     Text="资源包都会一起消失，且无法恢复。" NoPrefix="yes" TabSkip="yes"></ns0:Control>
        <ns0:Control Id="NoteText2" Type="Text" X="25" Y="104" Width="320" Height="16"
                     Text="不勾选则只卸载启动器本身，数据保留。" NoPrefix="yes" TabSkip="yes"></ns0:Control>

        <ns0:Control Id="DeleteDataCheck" Type="CheckBox" X="25" Y="140" Width="320" Height="18"
                     Property="REMOVE_MINECRAFT" CheckBoxValue="1"
                     Text="同时删除 .minecraft 文件夹" TabSkip="no"></ns0:Control>

        <ns0:Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                     Text="!(loc.WixUIBack)" TabSkip="no"></ns0:Control>
        <ns0:Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                     Text="!(loc.WixUINext)" Default="yes" TabSkip="no"></ns0:Control>
        <ns0:Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                     Text="!(loc.WixUICancel)" Cancel="yes" TabSkip="no">
          <ns0:Publish Event="SpawnDialog" Value="CancelDlg"></ns0:Publish>
        </ns0:Control>
      </ns0:Dialog>
    </ns0:UI>
  </ns0:Fragment>

</ns0:Wix>
